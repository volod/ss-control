# Non-secret defaults. Secrets go in gitignored `.env.secrets`
# (`make credentials` / `python -m ss_control.stack credentials`).
# See docs/reference/secrets-management.md.

DATA_DIR=.data
SS_CONTROL_DOMAIN=ss-control.test
SS_CONTROL_BIND=0.0.0.0
SS_CONTROL_HTTP_PORT=80
SS_CONTROL_HTTPS_PORT=443
SS_VIDEO_UI_UPSTREAM=upstream-stub:8080
FRIGATE_UPSTREAM=upstream-stub:8080
CHIRPSTACK_UPSTREAM=upstream-stub:8080
FUSION_UPSTREAM=upstream-stub:8080
