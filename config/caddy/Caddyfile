{
	admin localhost:2019
	auto_https off
	https_port 443
	http_port 80
}

http:// {
	redir https://{host}{uri} permanent
}

https://grafana.{$SS_CONTROL_DOMAIN} {
	tls /etc/caddy/certs/caddy.crt /etc/caddy/certs/caddy.key
	reverse_proxy grafana:3000
}

https://auth.{$SS_CONTROL_DOMAIN} {
	tls /etc/caddy/certs/caddy.crt /etc/caddy/certs/caddy.key
	reverse_proxy authelia:9091
}

https://nodered.{$SS_CONTROL_DOMAIN} {
	tls /etc/caddy/certs/caddy.crt /etc/caddy/certs/caddy.key
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
	}
	reverse_proxy nodered:1880
}

https://chirpstack.{$SS_CONTROL_DOMAIN} {
	tls /etc/caddy/certs/caddy.crt /etc/caddy/certs/caddy.key
	reverse_proxy {$CHIRPSTACK_UPSTREAM}
}

